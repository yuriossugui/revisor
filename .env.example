# ========================================
# Groq API Configuration
# ========================================
# Obtenha sua chave em: https://console.groq.com/keys
# OBRIGATÓRIO: Não deixe em branco ou com valor padrão
VITE_GROQ_API_KEY=your_groq_api_key_here

# URL base da API Groq (normalmente não precisa alterar)
VITE_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelo padrão a usar
# Opções: llama-3.1-8b-instant, llama-3.1-70b-versatile, llama-3.3-70b-versatile
VITE_GROQ_MODEL=llama-3.1-8b-instant

# ========================================
# Chat Configuration
# ========================================
# Timeout das requisições em milissegundos (padrão: 30000 = 30s)
VITE_CHAT_TIMEOUT=30000

# Máximo de tokens na resposta (padrão: 2048)
VITE_CHAT_MAX_TOKENS=2048

# Temperature (0 = determinístico, 2 = criativo. Padrão: 0.7)
VITE_CHAT_TEMPERATURE=0.7

# ========================================
# Debug & Logging
# ========================================
# Ativar modo debug com logs detalhados (true/false)
VITE_DEBUG_MODE=false
